# =============================================================
# PC SCAN APP - BACKEND ENVIRONMENT VARIABLES (EXAMPLE)
# =============================================================
# INSTRUCTIONS:
# 1. Kopyahin ang file na ito at palitan ang pangalan ng ".env"
# 2. Ilagay ang TUNAY na API keys at configuration sa ibaba
# 3. HUWAG ipupush ang .env file sa Git (dapat naka-.gitignore)
# =============================================================

# =============================================================
# GOOGLE GEMINI API
# Model: gemini-1.5-flash (para sa OCR at component identification)
# Kumuha ng API key dito: https://aistudio.google.com/apikey
# =============================================================
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048

# =============================================================
# OPENAI API
# Model: gpt-4o-mini (para sa build analysis, bottleneck, upgrade path)
# Kumuha ng API key dito: https://platform.openai.com/api-keys
# =============================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1024

# Optional: OpenAI Organization ID (kung meron)
OPENAI_ORG_ID=

# =============================================================
# SERVER CONFIGURATION
# =============================================================
# Host: 0.0.0.0 = accessible sa local network (para sa Android Emulator)
#       127.0.0.1 = localhost only
# Android Emulator -> Host PC: gumamit ng 10.0.2.2:8000
# =============================================================
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# =============================================================
# CORS SETTINGS (para sa Android App connection)
# =============================================================
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# =============================================================
# FILE UPLOAD SETTINGS
# =============================================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=./temp_uploads

# =============================================================
# DEMO / MOCK MODE (TESTING WITHOUT API CREDITS)
# =============================================================
# MOCK_MODE=true  = Bypass AI APIs, return demo data (NO COST)
# MOCK_MODE=false = Use real Gemini + OpenAI APIs (needs credits)
# AUTO_FALLBACK=true  = If API fails, auto-switch to mock
# AUTO_FALLBACK=false = Return error immediately if API fails
# =============================================================
MOCK_MODE=false
AUTO_FALLBACK=true
