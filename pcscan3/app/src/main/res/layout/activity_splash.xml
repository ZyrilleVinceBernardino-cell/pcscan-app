<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guidelineCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.46" />

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/bg_splash_blue_glow"
        app:layout_constraintBottom_toTopOf="@id/logoTile"
        app:layout_constraintEnd_toEndOf="@id/logoTile"
        app:layout_constraintStart_toStartOf="@id/logoTile"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/bg_splash_purple_glow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/logoTile"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoTile" />

    <FrameLayout
        android:id="@+id/logoTile"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_loading_logo_tile"
        app:layout_constraintBottom_toTopOf="@id/tvBrand"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/guidelineCenter">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_gravity="center"
            android:contentDescription="PC Scan icon"
            android:src="@drawable/ic_pc_tower_blue" />

        <FrameLayout
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_round_badge">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:contentDescription="AI indicator"
                android:src="@drawable/ic_loading_sparkle"
                android:tint="@color/text_white" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoTile">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="PC"
            android:textColor="@color/text_white"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="Scan"
            android:textColor="@color/primary_light"
            android:textSize="28sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Build Smarter. Upgrade Better."
        android:textColor="@color/textMuted"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvBrand" />

    <ProgressBar
        android:id="@+id/progressTrack"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="280dp"
        android:layout_height="3dp"
        android:layout_marginBottom="104dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary_light"
        android:indeterminateTintMode="src_in"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progressBackgroundTint="@color/border"
        android:splitTrack="false"
        app:layout_constraintBottom_toTopOf="@id/tvLoading"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="78dp"
        android:fontFamily="monospace"
        android:letterSpacing="0.02"
        android:text="Initializing AI Engine..."
        android:textColor="@color/textMuted"
        android:textSize="15sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
