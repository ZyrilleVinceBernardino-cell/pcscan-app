<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="OCR Scanner"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/scannerSurface"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_ocr_scanner_surface"
        android:clipToOutline="true"
        android:outlineProvider="background">

        <androidx.camera.view.PreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="top|start"
                android:background="@color/secondary_light" />

            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="top|start"
                android:background="@color/secondary_light" />

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="top|end"
                android:background="@color/secondary_light" />

            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:background="@color/secondary_light" />

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|start"
                android:background="@color/secondary_light" />

            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|start"
                android:background="@color/secondary_light" />

            <View
                android:layout_width="24dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom|end"
                android:background="@color/secondary_light" />

            <View
                android:layout_width="3dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|end"
                android:background="@color/secondary_light" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="Scanning"
                    android:src="@android:drawable/ic_menu_camera"
                    android:tint="@color/secondary_light" />

                <TextView
                    android:id="@+id/tvScanningTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Scanning..."
                    android:textColor="@color/text_white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvScanningHint"
                    android:layout_width="240dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Reading component box text"
                    android:textColor="@color/text_secondary"
                    android:textSize="15sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:layout_marginBottom="54dp"
                android:background="@color/secondary" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGeminiAIScan"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/primary"
            android:text="Use AI (Gemini) to Identify"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRescanOCR"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:text="Reset Scanner"
            android:textAllCaps="false"
            android:textColor="@color/text_white"
            android:textSize="15sp" />
    </LinearLayout>

</LinearLayout>
