<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutComponentCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivComponentIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_search_result"
        android:padding="12dp"
        android:contentDescription="Component"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvComponentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Component Name"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"/>

        <TextView
            android:id="@+id/tvComponentHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to select"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tvSelectionState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_status_chip"
        android:minWidth="72dp"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="Select"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"/>

    <ImageView
        android:id="@+id/ivArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@android:drawable/ic_menu_send"
        android:rotation="180"
        android:contentDescription="Arrow"/>

</LinearLayout>
