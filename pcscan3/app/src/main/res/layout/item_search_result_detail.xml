<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="16dp">

    <!-- Component Image Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/bg_search_result_container"
        android:gravity="top|end"
        android:orientation="vertical">

        <!-- Component Type Chip -->
        <TextView
            android:id="@+id/tvComponentType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_component_type_chip"
            android:paddingLeft="12dp"
            android:paddingTop="6dp"
            android:paddingRight="12dp"
            android:paddingBottom="6dp"
            android:text="GPU"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Component Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_card">

        <TextView
            android:id="@+id/tvComponentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NVIDIA GeForce RTX 4070 Ti"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_white" />

        <TextView
            android:id="@+id/tvComponentSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NVIDIA • GPU"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <!-- Progress Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="92/100"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="92"
                android:progressDrawable="@drawable/bg_search_progress" />

        </LinearLayout>

        <!-- Specs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/plain_check"
                    android:contentDescription="Check" />

                <TextView
                    android:id="@+id/tvSpec1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="16GB GDDR6X"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    android:layout_marginStart="8dp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/plain_check"
                    android:contentDescription="Check"
                    android:layout_marginStart="24dp" />

                <TextView
                    android:id="@+id/tvSpec2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2610 MHz Boost"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/plain_check"
                    android:contentDescription="Check" />

                <TextView
                    android:id="@+id/tvSpec3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="285W TDP"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    android:layout_marginStart="8dp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/plain_check"
                    android:contentDescription="Check"
                    android:layout_marginStart="24dp" />

                <TextView
                    android:id="@+id/tvSpec4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PCIe 4.0 x16"
                    android:textSize="14sp"
                    android:textColor="@color/text_white"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- AI Confidence Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_ai_confidence"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/check_circle"
            android:contentDescription="Check"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvAiConfidence"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI identified this component with 97% confidence. Compatibility is checked automatically before generating recommendations."
            android:textSize="14sp"
            android:textColor="@color/primary" />

    </LinearLayout>

</LinearLayout>